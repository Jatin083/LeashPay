# Copy to .env.local and fill in your own values. Never commit .env.local.

# PayPal Developer Dashboard > Apps & Credentials > Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Where PayPal sends the buyer back after approval
APP_URL=http://localhost:3000

# The shopping agent needs at least ONE AI key. Groq, Gemini and OpenRouter have free tiers.
# Set more than one and the others become automatic backups when one is rate-limited.
# Groq Console > API Keys (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b)
GROQ_MODEL=

# Google AI Studio > Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.6-flash)
GEMINI_MODEL=

# OpenRouter > Keys (https://openrouter.ai/keys). Free models; 50 requests a day without credit.
OPENROUTER_API_KEY=
# Optional: one OpenRouter model (default: google/gemma-4-31b-it:free with two free backups)
OPENROUTER_MODEL=

# Paid: Anthropic Console > API keys (Claude). Used instead of Groq when set.
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-sonnet-5-5)
LEASHPAY_MODEL=

# Optional: force the first provider: "groq", "gemini", "openrouter" or "anthropic"
LEASHPAY_PROVIDER=
