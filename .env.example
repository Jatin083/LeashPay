# Copy to .env.local and fill in your own values. Never commit .env.local.

# PayPal Developer Dashboard > Apps & Credentials > Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Where PayPal sends the buyer back after approval
APP_URL=http://localhost:3000

# The shopping agent needs ONE of these two.
# Free: Groq Console > API Keys (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: Groq model (default llama-3.3-70b-versatile)
GROQ_MODEL=

# Paid: Anthropic Console > API keys (Claude). Used instead of Groq when set.
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-sonnet-5-5)
LEASHPAY_MODEL=

# Optional: force one provider, "groq" or "anthropic"
LEASHPAY_PROVIDER=
